{
	"name": "@unveil/vk",
	"version": "0.5.0",
	"description": "Fetch GitHub account activity and analyze it for automation patterns",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "biome check",
		"check:fix": "biome check --write",
		"dev": "tsdown --watch",
		"build": "tsdown",
		"prepublishOnly": "pnpm test && pnpm check && pnpm build"
	},
	"keywords": [
		"GitHub",
		"ai",
		"ai-agent",
		"ai-detection",
		"automation",
		"behavioral-analysis"
	],
	"author": "Matteo Gabriele <m.gabriele.dev@gmail.com>",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/node": "^26.1.2",
		"publint": "^0.3.22",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@unveil/identity": "^2.0.4"
	}
}
